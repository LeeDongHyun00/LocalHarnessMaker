{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One Luna call accounting JSONL record (proposed)",
  "description": "Interface version 3 proposal; not frozen until explicit user approval of the schema set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "call_id",
    "phase",
    "backend",
    "requested_model",
    "model",
    "reasoning_effort",
    "status",
    "error",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "latency_seconds",
    "usd",
    "pricing_ref",
    "cost_basis"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "requirements",
        "claim_audit"
      ]
    },
    "backend": {
      "enum": [
        "codex_cli",
        "cheap_api"
      ]
    },
    "requested_model": {
      "const": "gpt-6-luna"
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reasoning_effort": {
      "const": "low"
    },
    "status": {
      "enum": [
        "success",
        "error",
        "timeout",
        "pin_mismatch"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "latency_seconds": {
      "type": "number",
      "minimum": 0
    },
    "usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "pricing_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cost_basis": {
      "const": "api_equivalent_usd"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "const": "gpt-6-luna"
          },
          "pricing_ref": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
