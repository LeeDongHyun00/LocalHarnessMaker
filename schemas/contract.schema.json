{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution contract (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_summary", "constraints", "success_criteria", "verification", "stop_conditions", "assumptions", "reasoning_effort", "cost_estimate"],
  "properties": {
    "task_summary": {"type": "string", "minLength": 1},
    "constraints": {"$ref": "#/$defs/strings"},
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "check"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "check": {
            "oneOf": [
              {"$ref": "#/$defs/commandCheck"},
              {"$ref": "#/$defs/fileCheck"},
              {"$ref": "#/$defs/regexCheck"},
              {"$ref": "#/$defs/judgeCheck"}
            ]
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "expected"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "expected": {"$ref": "#/$defs/expected"}
        }
      }
    },
    "stop_conditions": {"$ref": "#/$defs/strings"},
    "assumptions": {"$ref": "#/$defs/strings"},
    "reasoning_effort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rationale"],
      "properties": {
        "value": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "cost_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "usd"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "usd": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "referencePrompt": {
      "description": "JSON string fixture for prompt.json; not an additional controller CLI envelope.",
      "type": "string",
      "minLength": 1
    },
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code"],
      "properties": {
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "stdout": {"type": "string", "description": "Optional exact stdout, including trailing newlines."}
      }
    },
    "commandCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "command", "expected"],
      "properties": {
        "type": {"const": "command"},
        "command": {"type": "string", "minLength": 1},
        "expected": {"$ref": "#/$defs/expected"}
      }
    },
    "fileCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"const": "file_exists"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "regexCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "pattern"],
      "properties": {
        "type": {"const": "regex"},
        "path": {"type": "string", "minLength": 1},
        "pattern": {"type": "string", "minLength": 1}
      }
    },
    "judgeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rubric"],
      "properties": {
        "type": {"const": "llm_judge"},
        "rubric": {"type": "string", "minLength": 1}
      }
    }
  }
}
