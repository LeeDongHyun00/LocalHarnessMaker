d_text()); methods = [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name.startswith(\\\\\\\"test\\\\\\\")]; assert len(methods) >= 3; assert any(\\\\\\\"batch\\\\\\\" in n.name.lower() or \\\\\\\"many\\\\\\\" in n.name.lower() for n in methods)'\\\",\\\"expected\\\":{\\\"exit_code\\\":0}}},{\\\"id\\\":\\\"SC-4\\\",\\\"description\\\":\\\"The unittest suite passes.\\\",\\\"check\\\":{\\\"type\\\":\\\"command\\\",\\\"command\\\":\\\"python -m unittest discover -v\\\",\\\"expected\\\":{\\\"exit_code\\\":0}}},{\\\"id\\\":\\\"SC-5\\\",\\\"description\\\":\\\"HANDOFF.md records the verification command and an observed result.\\\",\\\"check\\\":{\\\"type\\\":\\\"regex\\\",\\\"path\\\":\\\"HANDOFF.md\\\",\\\"pattern\\\":\\\"(?is)(?=.*python -m unittest discover -v)(?=.*(?:observed result|result)\\\\\\\\s*[:\\\\\\\\-].*(?:passed|ok|tests?))\\\"}}],\\\"verification\\\":[{\\\"command\\\":\\\"python -m py_compile solution.py\\\",\\\"expected\\\":{\\\"exit_code\\\":0}},{\\\"command\\\":\\\"python -c 'import ast; from pathlib import Path; tree = ast.parse(Path(\\\\\\\"test_solution.py\\\\\\\").read_text()); methods = [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name.startswith(\\\\\\\"test\\\\\\\")]; assert len(methods) >= 3; assert any(\\\\\\\"batch\\\\\\\" in n.name.lower() or \\\\\\\"many\\\\\\\" in n.name.lower() for n in methods)'\\\",\\\"expected\\\":{\\\"exit_code\\\":0}},{\\\"command\\\":\\\"python -m unittest discover -v\\\",\\\"expected\\\":{\\\"exit_code\\\":0}}],\\\"stop_conditions\\\":[],\\\"assumptions\\\":[\\\"The handoff identifies solution.py, test_solution.py, and HANDOFF.md as the relevant workspace paths; their existence and contents have not been independently inspected.\\\",\\\"The target file may not exist yet and may be created.\\\",\\\"The public API is implemented in solution.py, and its unique function accepts each cases tuple as positional arguments; preserve the existing unique implementation and behavior.\\\"