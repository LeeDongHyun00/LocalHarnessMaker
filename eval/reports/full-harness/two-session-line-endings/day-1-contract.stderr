ery command completes successfully.\\\",\\\"check\\\":{\\\"type\\\":\\\"command\\\",\\\"command\\\":\\\"python -m unittest discover -v\\\",\\\"expected\\\":{\\\"exit_code\\\":0}}},{\\\"id\\\":\\\"SC-4\\\",\\\"description\\\":\\\"HANDOFF.md records design decisions and the verification command.\\\",\\\"check\\\":{\\\"type\\\":\\\"regex\\\",\\\"path\\\":\\\"HANDOFF.md\\\",\\\"pattern\\\":\\\"(?is)(design decision|design choice).*(python -m unittest discover -v)|(python -m unittest discover -v).*(design decision|design choice)\\\"}}],\\\"verification\\\":[{\\\"command\\\":\\\"python -m py_compile solution.py\\\",\\\"expected\\\":{\\\"exit_code\\\":0}},{\\\"command\\\":\\\"python -c 'import ast; from pathlib import Path; tree = ast.parse(Path(\\\\\\\"test_solution.py\\\\\\\").read_text()); count = sum(isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name.startswith(\\\\\\\"test\\\\\\\") for cls in ast.walk(tree) if isinstance(cls, ast.ClassDef) and any((isinstance(base, ast.Name) and base.id == \\\\\\\"TestCase\\\\\\\") or (isinstance(base, ast.Attribute) and base.attr == \\\\\\\"TestCase\\\\\\\") for base in cls.bases) for node in cls.body); assert count >= 3'\\\",\\\"expected\\\":{\\\"exit_code\\\":0}},{\\\"command\\\":\\\"python -m unittest discover -v\\\",\\\"expected\\\":{\\\"exit_code\\\":0}}],\\\"stop_conditions\\\":[],\\\"assumptions\\\":[\\\"The named files solution.py, test_solution.py, and HANDOFF.md are relative paths in the supplied task workspace; requested output files may not exist yet and may be created.\\\",\\\"The normalize function belongs in solution.py and is the public API exercised by tests in test_solution.py.\\\",\\\"The standard library unittest discovery command `python -m unittest discover -v` discovers the public tests in the supplied workspace.\\\",\\\"The HANDOFF.md design decisions and verification command can be documented in prose; the content check expects a design-decision phrase and the exact verification command t