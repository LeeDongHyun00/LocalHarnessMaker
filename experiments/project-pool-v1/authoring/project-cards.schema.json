{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projects"
  ],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      },
      "minItems": 2,
      "maxItems": 3
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "domain",
        "title",
        "purpose",
        "target_users",
        "scenario",
        "common_context",
        "requirements",
        "user_decisions",
        "optional",
        "out_of_scope",
        "implementation_defaults",
        "limitations",
        "work_type",
        "starting_state",
        "initial_requests",
        "technology_policy"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "enum": [
            "frontend",
            "backend",
            "fullstack",
            "cli_data"
          ]
        },
        "title": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "target_users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenario": {
          "type": "string"
        },
        "common_context": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "critical",
              "acceptance",
              "evaluation_method",
              "correction_feedback",
              "requirement_scope"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "critical": {
                "type": "boolean"
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "given",
                    "when",
                    "then"
                  ],
                  "properties": {
                    "given": {
                      "type": "string",
                      "minLength": 1
                    },
                    "when": {
                      "type": "string",
                      "minLength": 1
                    },
                    "then": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "evaluation_method": {
                "type": "string",
                "enum": [
                  "browser",
                  "http",
                  "cli",
                  "artifact",
                  "manual"
                ]
              },
              "correction_feedback": {
                "type": "string"
              },
              "requirement_scope": {
                "type": "string",
                "enum": [
                  "deliver_new",
                  "change",
                  "preserve"
                ]
              }
            }
          }
        },
        "user_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "topic",
              "question_examples",
              "answer",
              "requirement_ids"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "question_examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "answer": {
                "type": "string"
              },
              "requirement_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "minItems": 3,
          "maxItems": 5
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementation_defaults": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "work_type": {
          "type": "string",
          "enum": [
            "new_build",
            "feature_extension",
            "bug_fix"
          ]
        },
        "starting_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "blueprint",
            "proposed_stack",
            "expected_before_behavior",
            "known_defects"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "new_workspace",
                "baseline_not_materialized"
              ]
            },
            "blueprint": {
              "type": "string"
            },
            "proposed_stack": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expected_before_behavior": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "known_defects": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "initial_requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "underspecified",
            "clear"
          ],
          "properties": {
            "underspecified": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "requirement_ids",
                "omitted_decision_ids",
                "expected_question_action"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "omitted_decision_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "expected_question_action": {
                  "type": "string",
                  "enum": [
                    "clarify",
                    "pass_or_enrich"
                  ]
                }
              }
            },
            "clear": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "requirement_ids",
                "omitted_decision_ids",
                "expected_question_action"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "omitted_decision_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "expected_question_action": {
                  "type": "string",
                  "enum": [
                    "clarify",
                    "pass_or_enrich"
                  ]
                }
              }
            }
          }
        },
        "technology_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "rationale",
            "required_evidence"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "candidate",
                "maintain_existing",
                "withhold"
              ]
            },
            "rationale": {
              "type": "string"
            },
            "required_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
